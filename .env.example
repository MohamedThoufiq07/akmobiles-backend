# ---- Django ----
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
NODE_ENV=development
ALLOWED_HOSTS=*

# ---- PostgreSQL ----
DB_NAME=akmobiles
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Set USE_SQLITE=True to run without Postgres (quick local testing)
USE_SQLITE=False

# ---- JWT (matches old JWT_SECRET / JWT_EXPIRE) ----
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRE_DAYS=7

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL=False

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
